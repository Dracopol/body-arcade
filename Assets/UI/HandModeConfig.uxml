<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="HandModeConfig.uss" />
    <ui:VisualElement class="config-root">

        <!-- Header -->
        <ui:VisualElement class="config-header">
            <ui:VisualElement class="config-header__icon" />
            <ui:VisualElement class="config-header__text">
                <ui:Label class="config-header__title" text="VR Physiotherapy Configuration" />
                <ui:Label class="config-header__subtitle" text="Configure your therapy session settings before starting" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Hand Mode Selection -->
        <ui:VisualElement class="section-card">
            <ui:VisualElement class="section-header">
                <ui:VisualElement class="section-header__icon" />
                <ui:Label class="section-header__label" text="Hand Mode Selection" />
            </ui:VisualElement>

            <ui:VisualElement name="option-left-hand" class="option-row">
                <ui:VisualElement class="radio-outer" picking-mode="Ignore">
                    <ui:VisualElement class="radio-inner" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="option-text" picking-mode="Ignore">
                    <ui:Label class="option-text__label" text="Left Hand Only" picking-mode="Ignore" />
                    <ui:Label class="option-text__desc" text="Exercise using only the left hand" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="option-right-hand" class="option-row">
                <ui:VisualElement class="radio-outer" picking-mode="Ignore">
                    <ui:VisualElement class="radio-inner" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="option-text" picking-mode="Ignore">
                    <ui:Label class="option-text__label" text="Right Hand Only" picking-mode="Ignore" />
                    <ui:Label class="option-text__desc" text="Exercise using only the right hand" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="option-both-hands" class="option-row">
                <ui:VisualElement class="radio-outer" picking-mode="Ignore">
                    <ui:VisualElement class="radio-inner" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="option-text" picking-mode="Ignore">
                    <ui:Label class="option-text__label" text="Both Hands Simultaneously" picking-mode="Ignore" />
                    <ui:Label class="option-text__desc" text="Exercise using both hands together" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Both Hands Options (hidden by default) -->
        <ui:VisualElement name="both-hands-options" class="section-card options-panel">
            <ui:VisualElement class="section-header">
                <ui:VisualElement class="section-header__icon" />
                <ui:Label class="section-header__label" text="Both Hands Options" />
            </ui:VisualElement>

            <ui:VisualElement class="mirror-row">
                <ui:VisualElement name="mirror-unmirrored" class="mirror-btn">
                    <ui:Label class="mirror-btn__label" text="Unmirrored" picking-mode="Ignore" />
                    <ui:Label class="mirror-btn__desc" text="Each hand moves independently" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="mirror-left" class="mirror-btn">
                    <ui:Label class="mirror-btn__label" text="Mirror Left Hand" picking-mode="Ignore" />
                    <ui:Label class="mirror-btn__desc" text="Right hand mirrors left hand movements" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="mirror-right" class="mirror-btn">
                    <ui:Label class="mirror-btn__label" text="Mirror Right Hand" picking-mode="Ignore" />
                    <ui:Label class="mirror-btn__desc" text="Left hand mirrors right hand movements" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>