<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/HandModeConfig.uss?fileID=7433441132597879392&amp;guid=42ac2fc5a8f3f5944a1364409102cd34&amp;type=3#HandModeConfig"/>
    <ui:VisualElement class="config-root">

        <!-- Header -->
        <ui:VisualElement class="config-header">
            <ui:VisualElement class="config-header__icon" />
            <ui:VisualElement class="config-header__text">
                <ui:VisualElement name="game-switcher" class="game-switcher">
                    <ui:Label name="game-switcher__label" class="game-switcher__label" text="Air Sac Shapes" picking-mode="Ignore" />
                    <ui:Label class="game-switcher__arrow" text="∨" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label text="Configure your therapy session settings before starting" class="config-header__subtitle" />
            </ui:VisualElement>
            <ui:VisualElement class="header-right">
                <ui:VisualElement name="theme-switcher" class="theme-switcher">
                    <ui:Label name="theme-switcher__label" class="theme-switcher__label" text="Minimalist" picking-mode="Ignore" />
                    <ui:Label class="theme-switcher__arrow" text="∨" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="advanced-toggle" class="advanced-toggle">
                    <ui:Label text="Advanced Settings" picking-mode="Ignore" class="advanced-toggle__label" />
                    <ui:VisualElement picking-mode="Ignore" class="toggle-track">
                        <ui:VisualElement picking-mode="Ignore" class="toggle-knob" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Air Sac Shapes Content -->
        <ui:VisualElement name="content-airsac" class="game-content">

            <!-- Hand Mode Selection -->
            <ui:VisualElement class="section-card">
                <ui:VisualElement class="section-header">
                    <ui:VisualElement class="section-header__icon" />
                    <ui:Label text="Hand Mode Selection" class="section-header__label" />
                </ui:VisualElement>
                <ui:VisualElement name="option-left-hand" class="option-row">
                    <ui:VisualElement picking-mode="Ignore" class="radio-outer">
                        <ui:VisualElement picking-mode="Ignore" class="radio-inner" />
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="option-text">
                        <ui:Label text="Left Hand Only" picking-mode="Ignore" class="option-text__label" />
                        <ui:Label text="Exercise using only the left hand" picking-mode="Ignore" class="option-text__desc" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="option-right-hand" class="option-row">
                    <ui:VisualElement picking-mode="Ignore" class="radio-outer">
                        <ui:VisualElement picking-mode="Ignore" class="radio-inner" />
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="option-text">
                        <ui:Label text="Right Hand Only" picking-mode="Ignore" class="option-text__label" />
                        <ui:Label text="Exercise using only the right hand" picking-mode="Ignore" class="option-text__desc" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="option-both-hands" class="option-row">
                    <ui:VisualElement picking-mode="Ignore" class="radio-outer">
                        <ui:VisualElement picking-mode="Ignore" class="radio-inner" />
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="option-text">
                        <ui:Label text="Both Hands Simultaneously" picking-mode="Ignore" class="option-text__label" />
                        <ui:Label text="Exercise using both hands together" picking-mode="Ignore" class="option-text__desc" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Both Hands Options -->
            <ui:VisualElement name="both-hands-options" class="section-card options-panel">
                <ui:VisualElement class="section-header">
                    <ui:VisualElement class="section-header__icon" />
                    <ui:Label text="Both Hands Options" class="section-header__label" />
                </ui:VisualElement>
                <ui:VisualElement class="mirror-row">
                    <ui:VisualElement name="mirror-unmirrored" class="mirror-btn">
                        <ui:Label text="Unmirrored" picking-mode="Ignore" class="mirror-btn__label" />
                        <ui:Label text="Each hand moves independently" picking-mode="Ignore" class="mirror-btn__desc" />
                    </ui:VisualElement>
                    <ui:VisualElement name="mirror-left" class="mirror-btn">
                        <ui:Label text="Mirror Left Hand" picking-mode="Ignore" class="mirror-btn__label" />
                        <ui:Label text="Right hand mirrors left hand movements" picking-mode="Ignore" class="mirror-btn__desc" />
                    </ui:VisualElement>
                    <ui:VisualElement name="mirror-right" class="mirror-btn">
                        <ui:Label text="Mirror Right Hand" picking-mode="Ignore" class="mirror-btn__label" />
                        <ui:Label text="Left hand mirrors right hand movements" picking-mode="Ignore" class="mirror-btn__desc" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Difficulty Selection -->
            <ui:VisualElement class="section-card">
                <ui:VisualElement class="section-header">
                    <ui:VisualElement class="section-header__icon" />
                    <ui:Label text="Difficulty" class="section-header__label" />
                </ui:VisualElement>
                <ui:VisualElement class="mirror-row">
                    <ui:VisualElement name="difficulty-easy" class="mirror-btn">
                        <ui:Label text="Easy" picking-mode="Ignore" class="mirror-btn__label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="difficulty-medium" class="mirror-btn">
                        <ui:Label text="Medium" picking-mode="Ignore" class="mirror-btn__label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="difficulty-hard" class="mirror-btn">
                        <ui:Label text="Hard" picking-mode="Ignore" class="mirror-btn__label" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Strike Amount + Timer Settings -->
            <ui:VisualElement class="two-col-row">

                <!-- Strike Amount -->
                <ui:VisualElement class="section-card section-card--half">
                    <ui:VisualElement class="section-header">
                        <ui:VisualElement class="section-header__icon" />
                        <ui:Label text="Strike Amount" class="section-header__label" />
                    </ui:VisualElement>
                    <ui:VisualElement class="stepper-row">
                        <ui:VisualElement name="strike-decrease-btn" class="stepper-btn">
                            <ui:Label text="−" picking-mode="Ignore" class="stepper-btn__label" />
                        </ui:VisualElement>
                        <ui:VisualElement class="stepper-value-box">
                            <ui:Label name="strike-value-label" text="5" class="stepper-value" />
                        </ui:VisualElement>
                        <ui:VisualElement name="strike-increase-btn" class="stepper-btn">
                            <ui:Label text="+" picking-mode="Ignore" class="stepper-btn__label" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="strike-unlimited-btn" class="toggle-btn">
                        <ui:Label text="∞  Set to Unlimited" picking-mode="Ignore" class="toggle-btn__label" />
                    </ui:VisualElement>
                    <ui:Label name="strike-info-label" text="Target: 5 strikes" class="info-label" />
                </ui:VisualElement>

                <!-- Timer Settings -->
                <ui:VisualElement class="section-card section-card--half">
                    <ui:VisualElement class="section-header">
                        <ui:VisualElement class="section-header__icon" />
                        <ui:Label text="Timer Settings" class="section-header__label" />
                    </ui:VisualElement>
                    <ui:VisualElement class="stepper-row">
                        <ui:VisualElement name="timer-decrease-btn" class="stepper-btn">
                            <ui:Label text="−" picking-mode="Ignore" class="stepper-btn__label" />
                        </ui:VisualElement>
                        <ui:VisualElement class="stepper-value-box">
                            <ui:Label name="timer-value-label" text="60" class="stepper-value" />
                            <ui:Label text="sec" picking-mode="Ignore" class="stepper-unit" />
                        </ui:VisualElement>
                        <ui:VisualElement name="timer-increase-btn" class="stepper-btn">
                            <ui:Label text="+" picking-mode="Ignore" class="stepper-btn__label" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="timer-disable-btn" class="toggle-btn">
                        <ui:Label text="✕  Disable Timer" picking-mode="Ignore" class="toggle-btn__label" />
                    </ui:VisualElement>
                    <ui:Label name="timer-info-label" text="Session duration: 1m" class="info-label" />
                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

        <!-- NeuroMania Content -->
        <ui:VisualElement name="content-neuromania" class="game-content hidden">
            <ui:VisualElement name="neuro-hand-mode" class="section-card">
                <ui:VisualElement class="section-header">
                    <ui:VisualElement class="section-header__icon" />
                    <ui:Label text="Hand Mode" class="section-header__label" />
                </ui:VisualElement>
                <ui:Label text="Sets which hand targets favour during the session." class="section-description" />
                <ui:VisualElement name="option-normal" class="option-row">
                    <ui:VisualElement picking-mode="Ignore" class="radio-outer">
                        <ui:VisualElement picking-mode="Ignore" class="radio-inner" />
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="option-text">
                        <ui:Label text="Normal / Unfocused" picking-mode="Ignore" class="option-text__label" />
                        <ui:Label text="Balanced gameplay for both hands equally" picking-mode="Ignore" class="option-text__desc" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="option-left-focused" class="option-row">
                    <ui:VisualElement picking-mode="Ignore" class="radio-outer">
                        <ui:VisualElement picking-mode="Ignore" class="radio-inner" />
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="option-text">
                        <ui:Label text="Left Hand Focused" picking-mode="Ignore" class="option-text__label" />
                        <ui:Label text="Emphasize left hand training and exercises" picking-mode="Ignore" class="option-text__desc" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="option-right-focused" class="option-row">
                    <ui:VisualElement picking-mode="Ignore" class="radio-outer">
                        <ui:VisualElement picking-mode="Ignore" class="radio-inner" />
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="option-text">
                        <ui:Label text="Right Hand Focused" picking-mode="Ignore" class="option-text__label" />
                        <ui:Label text="Emphasize right hand training and exercises" picking-mode="Ignore" class="option-text__desc" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Height -->
            <ui:VisualElement name="neuro-height" class="section-card">
                <ui:VisualElement class="section-header">
                    <ui:VisualElement class="section-header__icon" />
                    <ui:Label text="Height" class="section-header__label" />
                </ui:VisualElement>
                <ui:Label text="Sets the height at which targets spawn during the session." class="section-description" />
                <ui:VisualElement name="option-eye-level" class="option-row">
                    <ui:VisualElement picking-mode="Ignore" class="radio-outer">
                        <ui:VisualElement picking-mode="Ignore" class="radio-inner" />
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="option-text">
                        <ui:Label text="Eye Level" picking-mode="Ignore" class="option-text__label" />
                        <ui:Label text="Targets arrive at chest and face height" picking-mode="Ignore" class="option-text__desc" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="option-height-high" class="option-row">
                    <ui:VisualElement picking-mode="Ignore" class="radio-outer">
                        <ui:VisualElement picking-mode="Ignore" class="radio-inner" />
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="option-text">
                        <ui:Label text="High" picking-mode="Ignore" class="option-text__label" />
                        <ui:Label text="Targets arrive at overhead and high-reach height" picking-mode="Ignore" class="option-text__desc" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="option-height-mixed" class="option-row">
                    <ui:VisualElement picking-mode="Ignore" class="radio-outer">
                        <ui:VisualElement picking-mode="Ignore" class="radio-inner" />
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="option-text">
                        <ui:Label text="Mixed" picking-mode="Ignore" class="option-text__label" />
                        <ui:Label text="A mix of eye level and high targets" picking-mode="Ignore" class="option-text__desc" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Target Bias -->
            <ui:VisualElement name="neuro-target-bias" class="section-card section-hidden">
                <ui:VisualElement class="section-header">
                    <ui:VisualElement class="section-header__icon" />
                    <ui:Label text="Target Bias" class="section-header__label" />
                </ui:VisualElement>
                <ui:Label text="Left–Right sets which hand targets favour. Up–Down sets punch height — eye level to overhead." class="bias-description" />
                <ui:VisualElement class="bias-wrapper">
                    <ui:Label text="Abduction" class="bias-axis-label" />
                    <ui:VisualElement class="bias-middle-row">
                        <ui:Label text="Left Hand" class="bias-axis-left" />
                        <ui:VisualElement name="bias-grid" class="bias-grid">
                            <ui:VisualElement picking-mode="Ignore" class="bias-grid__hline" />
                            <ui:VisualElement picking-mode="Ignore" class="bias-grid__vline" />
                            <ui:VisualElement name="bias-dot-ghost" picking-mode="Ignore" class="bias-dot bias-dot--ghost" />
                            <ui:VisualElement name="bias-dot-active" picking-mode="Ignore" class="bias-dot bias-dot--active" />
                        </ui:VisualElement>
                        <ui:Label text="Right Hand" class="bias-axis-right" />
                    </ui:VisualElement>
                    <ui:Label text="Adduction" class="bias-axis-label" />
                </ui:VisualElement>
                <ui:VisualElement class="bias-snap-group">
                    <ui:VisualElement class="bias-snap-row">
                        <ui:VisualElement name="snap-left-abduction" class="bias-snap-btn">
                            <ui:Label text="L. Abduction" picking-mode="Ignore" class="bias-snap-btn__label" />
                        </ui:VisualElement>
                        <ui:VisualElement name="snap-abduction" class="bias-snap-btn">
                            <ui:Label text="Abduction" picking-mode="Ignore" class="bias-snap-btn__label" />
                        </ui:VisualElement>
                        <ui:VisualElement name="snap-right-abduction" class="bias-snap-btn">
                            <ui:Label text="R. Abduction" picking-mode="Ignore" class="bias-snap-btn__label" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="bias-snap-row">
                        <ui:VisualElement name="snap-left" class="bias-snap-btn">
                            <ui:Label text="Left Hand" picking-mode="Ignore" class="bias-snap-btn__label" />
                        </ui:VisualElement>
                        <ui:VisualElement name="snap-default" class="bias-snap-btn bias-snap-btn--primary">
                            <ui:Label text="⊕  Default" picking-mode="Ignore" class="bias-snap-btn__label" />
                        </ui:VisualElement>
                        <ui:VisualElement name="snap-right" class="bias-snap-btn">
                            <ui:Label text="Right Hand" picking-mode="Ignore" class="bias-snap-btn__label" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="bias-snap-row">
                        <ui:VisualElement name="snap-left-adduction" class="bias-snap-btn">
                            <ui:Label text="L. Adduction" picking-mode="Ignore" class="bias-snap-btn__label" />
                        </ui:VisualElement>
                        <ui:VisualElement name="snap-adduction" class="bias-snap-btn">
                            <ui:Label text="Adduction" picking-mode="Ignore" class="bias-snap-btn__label" />
                        </ui:VisualElement>
                        <ui:VisualElement name="snap-right-adduction" class="bias-snap-btn">
                            <ui:Label text="R. Adduction" picking-mode="Ignore" class="bias-snap-btn__label" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Start Button -->
        <ui:VisualElement name="start-btn" class="start-btn">
            <ui:Label text="Start VR Session" picking-mode="Ignore" class="start-btn__label" />
        </ui:VisualElement>

        <!-- Dropdown — last so it renders on top -->
        <ui:VisualElement name="game-dropdown" class="game-dropdown">
            <ui:VisualElement name="dropdown-airsac" class="dropdown-item">
                <ui:Label text="Air Sac Shapes" picking-mode="Ignore" class="dropdown-item__label" />
            </ui:VisualElement>
            <ui:VisualElement name="dropdown-neuromania" class="dropdown-item">
                <ui:Label text="NeuroMania" picking-mode="Ignore" class="dropdown-item__label" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Theme Dropdown — last so it renders on top -->
        <ui:VisualElement name="theme-dropdown" class="game-dropdown">
            <ui:VisualElement name="theme-dropdown-minimalist" class="dropdown-item">
                <ui:Label text="Minimalist" picking-mode="Ignore" class="dropdown-item__label" />
            </ui:VisualElement>
            <ui:VisualElement name="theme-dropdown-sky" class="dropdown-item">
                <ui:Label text="Sky" picking-mode="Ignore" class="dropdown-item__label" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>