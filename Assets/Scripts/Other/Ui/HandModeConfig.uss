.config-root {
    flex-direction: column;
    padding: 24px;
    gap: 16px;
    background-image: url("cloud.jpg");
    -unity-background-scale-mode: scale-and-crop;
    width: 600px;
}

/* Game switcher */
.game-switcher {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 20px;
    border-width: 1px;
    border-color: #dddddd;
    background-color: #ffffff;
    align-self: flex-start;
    transition: background-color 0.1s;
}

.game-switcher:hover {
    background-color: #f5f5f5;
}

.game-switcher__label {
    font-size: 18px;
    -unity-font-style: bold;
    color: #111111;
}

.game-switcher__arrow {
    font-size: 12px;
    color: #555555;
}

/* Dropdown menu */
.game-dropdown {
    display: none;
    position: absolute;
    background-color: #ffffff;
    border-width: 1px;
    border-color: #dddddd;
    border-radius: 8px;
    padding: 4px;
    min-width: 180px;
}

.game-dropdown.open {
    display: flex;
    flex-direction: column;
}

.dropdown-item {
    padding: 10px 14px;
    border-radius: 6px;
    transition: background-color 0.1s;
}

.dropdown-item:hover {
    background-color: #f5f5f5;
}

.dropdown-item__label {
    font-size: 14px;
    color: #111111;
}

/* Game content panels */
.game-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.game-content.hidden {
    display: none;
}

/* Header */
.config-header {
    flex-direction: row;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
}

.config-header__icon {
    width: 24px;
    height: 24px;
}

.config-header__text {
    flex-direction: column;
    gap: 2px;
    flex: 1;
}

.config-header__title {
    font-size: 22px;
    -unity-font-style: bold;
    color: #111111;
}

.config-header__subtitle {
    font-size: 13px;
    color: #888888;
}

/* Section card */
.section-card {
    background-color: #ffffff;
    border-color: #e0e0e0;
    border-width: 1px;
    border-radius: 12px;
    padding: 20px;
    gap: 10px;
}

.section-card--half {
    flex: 1;
}

.section-header {
    flex-direction: row;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
}

.section-header__icon {
    width: 18px;
    height: 18px;
}

.section-header__label {
    font-size: 15px;
    -unity-font-style: bold;
    color: #111111;
}

.section-header__spacer {
    flex: 1;
}

/* Option rows */
.option-row {
    flex-direction: row;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-radius: 8px;
    border-width: 1px;
    border-color: #dddddd;
    background-color: #ffffff;
    transition: background-color 0.1s;
}

.option-row:hover {
    background-color: #f5f5f5;
}

.option-row.selected {
    background-color: #f0f0f0;
    border-color: #222222;
    border-width: 2px;
}

/* Radio button */
.radio-outer {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border-width: 2px;
    border-color: #555555;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.radio-inner {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: transparent;
}

.option-row.selected .radio-inner {
    background-color: #222222;
}

/* Option text */
.option-text {
    flex-direction: column;
    gap: 2px;
}

.option-text__label {
    font-size: 14px;
    -unity-font-style: bold;
    color: #111111;
}

.option-text__desc {
    font-size: 13px;
    color: #888888;
}

/* Both Hands Options panel */
.options-panel {
    display: none;
}

.options-panel.visible {
    display: flex;
}

/* Mirror buttons row */
.mirror-row {
    flex-direction: row;
    gap: 12px;
}

.mirror-btn {
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 16px 12px;
    border-radius: 8px;
    border-width: 1px;
    border-color: #dddddd;
    background-color: #ffffff;
    gap: 4px;
    transition: background-color 0.1s;
}

.mirror-btn:hover {
    background-color: #f5f5f5;
}

.mirror-btn.selected {
    background-color: #f0f0f0;
    border-color: #222222;
    border-width: 2px;
}

.mirror-btn__label {
    font-size: 14px;
    -unity-font-style: bold;
    color: #111111;
    -unity-text-align: middle-center;
}

.mirror-btn__desc {
    font-size: 12px;
    color: #888888;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Start button */
.start-btn {
    background-color: #111111;
    border-radius: 8px;
    padding: 14px 24px;
    align-items: center;
    align-self: flex-end;
    margin-top: 8px;
    transition: background-color 0.1s;
}

.start-btn:hover {
    background-color: #333333;
}

.start-btn__label {
    font-size: 14px;
    -unity-font-style: bold;
    color: #ffffff;
}

/* ─── Action buttons (Select All / Clear) ─── */
.action-btn {
    padding: 6px 12px;
    border-radius: 6px;
    border-width: 1px;
    border-color: #111111;
    background-color: #111111;
    transition: background-color 0.1s;
}

.action-btn:hover {
    background-color: #333333;
}

.action-btn--ghost {
    background-color: #ffffff;
    border-color: #dddddd;
}

.action-btn--ghost:hover {
    background-color: #f5f5f5;
}

.action-btn__label {
    font-size: 12px;
    -unity-font-style: bold;
    color: #ffffff;
}

.action-btn--ghost .action-btn__label {
    color: #111111;
}

/* ─── Shape grid ─── */
.shape-grid {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 12px;
}

.shape-card {
    flex: 1;
    min-width: 110px;
    flex-direction: column;
    border-radius: 8px;
    border-width: 1px;
    border-color: #e0e0e0;
    overflow: hidden;
    background-color: #ffffff;
    transition: border-color 0.1s;
}

.shape-card:hover {
    border-color: #aaaaaa;
}

.shape-card.selected {
    border-color: #111111;
    border-width: 2px;
}

.shape-card__thumbnail {
    height: 90px;
    align-items: center;
    justify-content: center;
}

.shape-card__thumbnail-label {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.85);
    -unity-text-align: middle-center;
    white-space: normal;
}

.shape-card__info {
    padding: 8px;
    flex-direction: column;
    gap: 2px;
}

.shape-card__name {
    font-size: 13px;
    -unity-font-style: bold;
    color: #111111;
    -unity-text-align: middle-center;
}

.shape-card__difficulty {
    font-size: 11px;
    color: #888888;
    -unity-text-align: middle-center;
}

.shape-count-label {
    font-size: 12px;
    color: #888888;
    margin-top: 2px;
}

/* ─── Two-column row ─── */
.two-col-row {
    flex-direction: row;
    gap: 16px;
}

/* ─── Steppers ─── */
.stepper-row {
    flex-direction: row;
    align-items: center;
    gap: 8px;
}

.stepper-btn {
    width: 34px;
    height: 34px;
    border-radius: 6px;
    border-width: 1px;
    border-color: #dddddd;
    background-color: #f5f5f5;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background-color 0.1s;
}

.stepper-btn:hover {
    background-color: #e8e8e8;
}

.stepper-btn.disabled {
    opacity: 0.35;
}

.stepper-btn.disabled:hover {
    background-color: #f5f5f5;
}

.stepper-btn__label {
    font-size: 18px;
    color: #111111;
    -unity-text-align: middle-center;
}

.stepper-value-box {
    flex: 1;
    flex-direction: row;
    align-items: center;
    height: 34px;
    border-radius: 6px;
    border-width: 1px;
    border-color: #dddddd;
    background-color: #f5f5f5;
    padding: 0 10px;
}

.stepper-value {
    flex: 1;
    font-size: 14px;
    -unity-font-style: bold;
    color: #111111;
    -unity-text-align: middle-center;
}

.stepper-unit {
    font-size: 12px;
    color: #888888;
}

/* ─── Toggle buttons (Unlimited / Disable Timer) ─── */
.toggle-btn {
    padding: 10px;
    border-radius: 6px;
    border-width: 1px;
    border-color: #dddddd;
    background-color: #ffffff;
    align-items: center;
    transition: background-color 0.1s;
}

.toggle-btn:hover {
    background-color: #f5f5f5;
}

.toggle-btn.active {
    background-color: #f0f0f0;
    border-color: #111111;
    border-width: 2px;
}

.toggle-btn__label {
    font-size: 13px;
    color: #111111;
    -unity-text-align: middle-center;
}

/* ─── Info labels ─── */
.info-label {
    font-size: 12px;
    color: #888888;
}

/* ─── Advanced toggle ─── */
.advanced-toggle {
    display: none;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
}

.advanced-toggle__label {
    font-size: 13px;
    -unity-font-style: bold;
    color: #111111;
}

.toggle-track {
    width: 36px;
    height: 20px;
    border-radius: 10px;
    background-color: #cccccc;
    transition: background-color 0.15s;
}

.toggle-track:hover {
    background-color: #bbbbbb;
}

.advanced-toggle.active .toggle-track {
    background-color: #111111;
}

.advanced-toggle.active .toggle-track:hover {
    background-color: #333333;
}

.toggle-knob {
    position: absolute;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background-color: #ffffff;
    top: 2px;
    left: 2px;
    transition: left 0.15s;
}

.advanced-toggle.active .toggle-knob {
    left: 18px;
}

/* ─── Section hidden utility ─── */
.section-hidden {
    display: none;
}

/* ─── Section description ─── */
.section-description {
    font-size: 12px;
    color: #888888;
    white-space: normal;
    margin-bottom: 2px;
}

/* ─── Bias picker ─── */
.bias-description {
    font-size: 12px;
    color: #888888;
    white-space: normal;
    margin-bottom: 4px;
}

.bias-wrapper {
    flex-direction: column;
    align-items: center;
    gap: 6px;
}

.bias-middle-row {
    flex-direction: row;
    align-items: center;
    gap: 8px;
}

.bias-axis-label {
    font-size: 12px;
    color: #888888;
    -unity-text-align: middle-center;
}

.bias-axis-left {
    width: 65px;
    font-size: 11px;
    color: #888888;
    white-space: normal;
    -unity-text-align: middle-center;
}

.bias-axis-right {
    width: 65px;
    font-size: 11px;
    color: #888888;
    white-space: normal;
    -unity-text-align: middle-center;
}

.bias-grid {
    width: 260px;
    height: 260px;
    background-color: #ebebf0;
    border-radius: 8px;
    border-width: 1px;
    border-color: #dddddd;
    overflow: hidden;
}

.bias-grid__hline {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: #cccccc;
}

.bias-grid__vline {
    position: absolute;
    left: 50%;
    top: 0;
    width: 1px;
    height: 100%;
    background-color: #cccccc;
}

.bias-dot {
    position: absolute;
}

.bias-dot--ghost {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: rgba(0, 0, 0, 0.18);
    left: 50%;
    top: 50%;
    margin-left: -5px;
    margin-top: -5px;
}

.bias-dot--active {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: #111111;
    left: 50%;
    top: 50%;
    margin-left: -6px;
    margin-top: -6px;
}

.bias-snap-group {
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
}

.bias-snap-row {
    flex-direction: row;
    gap: 8px;
    justify-content: center;
}

.bias-snap-btn {
    padding: 8px 16px;
    border-radius: 20px;
    border-width: 1px;
    border-color: #dddddd;
    background-color: #ffffff;
    align-items: center;
    transition: background-color 0.1s;
}

.bias-snap-btn:hover {
    background-color: #f5f5f5;
}

.bias-snap-btn--primary {
    background-color: #111111;
    border-color: #111111;
}

.bias-snap-btn--primary:hover {
    background-color: #333333;
}

.bias-snap-btn__label {
    font-size: 13px;
    -unity-font-style: bold;
    color: #111111;
}

.bias-snap-btn--primary .bias-snap-btn__label {
    color: #ffffff;
}