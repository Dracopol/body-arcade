<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/HandModeConfig.uss?fileID=7433441132597879392&amp;guid=42ac2fc5a8f3f5944a1364409102cd34&amp;type=3#HandModeConfig"/>
    <ui:VisualElement class="config-root">

        <!-- Header -->
        <ui:VisualElement class="config-header">
            <ui:VisualElement class="config-header__icon" />
            <ui:VisualElement class="config-header__text">
                <ui:VisualElement name="game-switcher" class="game-switcher">
                    <ui:Label name="game-switcher__label" class="game-switcher__label" text="Air Sac Shapes" picking-mode="Ignore" />
                    <ui:Label class="game-switcher__arrow" text="∨" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label text="Configure your therapy session settings before starting" class="config-header__subtitle" />
            </ui:VisualElement>
            <ui:VisualElement class="header-right">
<ui:VisualElement name="advanced-toggle" class="advanced-toggle">
                    <ui:Label text="Graph Style" picking-mode="Ignore" class="advanced-toggle__label" />
                    <ui:VisualElement picking-mode="Ignore" class="toggle-track">
                        <ui:VisualElement picking-mode="Ignore" class="toggle-knob" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Air Sac Shapes Content -->
        <ui:VisualElement name="content-airsac" class="game-content">

            <!-- Repetitions -->
            <ui:VisualElement class="section-card">
                <ui:VisualElement class="section-header">
                    <ui:VisualElement class="section-header__icon" />
                    <ui:Label text="Repetitions" class="section-header__label" />
                </ui:VisualElement>
                <ui:VisualElement class="stepper-row">
                    <ui:VisualElement name="reps-stepper-minus" class="stepper-btn">
                        <ui:Label text="−" picking-mode="Ignore" class="stepper-btn__label" />
                    </ui:VisualElement>
                    <ui:VisualElement class="stepper-value-box">
                        <ui:Label name="reps-stepper-value" text="1" picking-mode="Ignore" class="stepper-value" />
                    </ui:VisualElement>
                    <ui:VisualElement name="reps-stepper-plus" class="stepper-btn">
                        <ui:Label text="+" picking-mode="Ignore" class="stepper-btn__label" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Hand Mode -->
            <ui:VisualElement class="section-card">
                <ui:VisualElement class="section-header">
                    <ui:VisualElement class="section-header__icon" />
                    <ui:Label text="Hand Mode" class="section-header__label" />
                </ui:VisualElement>
                <ui:VisualElement class="mirror-row hm-btns-row">
                    <ui:VisualElement name="airsac-hm-btn-left-mixed" class="mirror-btn">
                        <ui:VisualElement picking-mode="Ignore" class="hand-icons-row">
                            <ui:VisualElement picking-mode="Ignore" class="hand-slot">
                                <ui:VisualElement picking-mode="Ignore" class="hand-icon hand-icon--left" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="hand-slot">
                                <ui:VisualElement picking-mode="Ignore" class="hand-icon hand-icon--small" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label text="Left" picking-mode="Ignore" class="mirror-btn__label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="airsac-hm-btn-mixed" class="mirror-btn">
                        <ui:VisualElement picking-mode="Ignore" class="hand-icons-row">
                            <ui:VisualElement picking-mode="Ignore" class="hand-slot">
                                <ui:VisualElement picking-mode="Ignore" class="hand-icon hand-icon--left" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="hand-slot">
                                <ui:VisualElement picking-mode="Ignore" class="hand-icon" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label text="Both" picking-mode="Ignore" class="mirror-btn__label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="airsac-hm-btn-right-mixed" class="mirror-btn">
                        <ui:VisualElement picking-mode="Ignore" class="hand-icons-row">
                            <ui:VisualElement picking-mode="Ignore" class="hand-slot">
                                <ui:VisualElement picking-mode="Ignore" class="hand-icon hand-icon--left hand-icon--small" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="hand-slot">
                                <ui:VisualElement picking-mode="Ignore" class="hand-icon" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label text="Right" picking-mode="Ignore" class="mirror-btn__label" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Difficulty Selection -->
            <ui:VisualElement class="section-card">
                <ui:VisualElement class="section-header">
                    <ui:VisualElement class="section-header__icon" />
                    <ui:Label text="Difficulty" class="section-header__label" />
                </ui:VisualElement>
                <ui:VisualElement class="mirror-row">
                    <ui:VisualElement name="difficulty-easy" class="mirror-btn">
                        <ui:VisualElement picking-mode="Ignore" class="star-row">
                            <ui:VisualElement picking-mode="Ignore" class="star-icon">
                                <ui:VisualElement picking-mode="Ignore" class="star-fill-layer" />
                                <ui:VisualElement picking-mode="Ignore" class="star-outline-layer" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="star-icon star-icon--outline" />
                            <ui:VisualElement picking-mode="Ignore" class="star-icon star-icon--outline" />
                        </ui:VisualElement>
                        <ui:Label text="Easy" picking-mode="Ignore" class="mirror-btn__label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="difficulty-medium" class="mirror-btn">
                        <ui:VisualElement picking-mode="Ignore" class="star-row">
                            <ui:VisualElement picking-mode="Ignore" class="star-icon">
                                <ui:VisualElement picking-mode="Ignore" class="star-fill-layer" />
                                <ui:VisualElement picking-mode="Ignore" class="star-outline-layer" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="star-icon">
                                <ui:VisualElement picking-mode="Ignore" class="star-fill-layer" />
                                <ui:VisualElement picking-mode="Ignore" class="star-outline-layer" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="star-icon star-icon--outline" />
                        </ui:VisualElement>
                        <ui:Label text="Medium" picking-mode="Ignore" class="mirror-btn__label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="difficulty-hard" class="mirror-btn">
                        <ui:VisualElement picking-mode="Ignore" class="star-row">
                            <ui:VisualElement picking-mode="Ignore" class="star-icon">
                                <ui:VisualElement picking-mode="Ignore" class="star-fill-layer" />
                                <ui:VisualElement picking-mode="Ignore" class="star-outline-layer" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="star-icon">
                                <ui:VisualElement picking-mode="Ignore" class="star-fill-layer" />
                                <ui:VisualElement picking-mode="Ignore" class="star-outline-layer" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="star-icon">
                                <ui:VisualElement picking-mode="Ignore" class="star-fill-layer" />
                                <ui:VisualElement picking-mode="Ignore" class="star-outline-layer" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label text="Hard" picking-mode="Ignore" class="mirror-btn__label" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Hand Visualization + Vibration -->
            <ui:VisualElement class="two-col-row">

                <!-- Hand Visualization -->
                <ui:VisualElement class="section-card section-card--half">
                    <ui:VisualElement class="section-header">
                        <ui:VisualElement class="section-header__icon" />
                        <ui:Label text="Hand Visualization" class="section-header__label" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mirror-row">
                        <ui:VisualElement name="hand-viz-btn-no" class="mirror-btn">
                            <ui:VisualElement picking-mode="Ignore" class="hand-viz-icon hand-viz-icon--no" />
                            <ui:Label text="No" picking-mode="Ignore" class="mirror-btn__label" />
                        </ui:VisualElement>
                        <ui:VisualElement name="hand-viz-btn-yes" class="mirror-btn">
                            <ui:VisualElement picking-mode="Ignore" class="hand-viz-icon hand-viz-icon--yes" />
                            <ui:Label text="Yes" picking-mode="Ignore" class="mirror-btn__label" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Vibration -->
                <ui:VisualElement class="section-card section-card--half">
                    <ui:VisualElement class="section-header">
                        <ui:VisualElement class="section-header__icon" />
                        <ui:Label text="Vibration" class="section-header__label" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mirror-row">
                        <ui:VisualElement name="vibration-btn-no" class="mirror-btn">
                            <ui:VisualElement picking-mode="Ignore" class="vibration-icon vibration-icon--no" />
                            <ui:Label text="No" picking-mode="Ignore" class="mirror-btn__label" />
                        </ui:VisualElement>
                        <ui:VisualElement name="vibration-btn-yes" class="mirror-btn">
                            <ui:VisualElement picking-mode="Ignore" class="vibration-icon vibration-icon--yes" />
                            <ui:Label text="Yes" picking-mode="Ignore" class="mirror-btn__label" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>

        </ui:VisualElement>

        <!-- NeuroMania Content -->
        <ui:VisualElement name="content-neuromania" class="game-content hidden">

            <!-- Hand Mode Selection -->
            <ui:VisualElement class="section-card">
                <ui:VisualElement class="section-header">
                    <ui:VisualElement class="section-header__icon" />
                    <ui:Label text="Hand Mode" class="section-header__label" />
                </ui:VisualElement>
                <ui:VisualElement class="mirror-row hm-btns-row">
                    <ui:VisualElement name="neuro-hm-btn-0" class="mirror-btn">
                        <ui:VisualElement picking-mode="Ignore" class="hand-slot">
                            <ui:VisualElement picking-mode="Ignore" class="hand-icon hand-icon--left" />
                        </ui:VisualElement>
                        <ui:Label text="Left" picking-mode="Ignore" class="mirror-btn__label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="neuro-hm-btn-2" class="mirror-btn">
                        <ui:VisualElement picking-mode="Ignore" class="hand-icons-row">
                            <ui:VisualElement picking-mode="Ignore" class="hand-slot">
                                <ui:VisualElement picking-mode="Ignore" class="hand-icon hand-icon--left" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="hand-slot">
                                <ui:VisualElement picking-mode="Ignore" class="hand-icon" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label text="Mixed" picking-mode="Ignore" class="mirror-btn__label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="neuro-hm-btn-4" class="mirror-btn">
                        <ui:VisualElement picking-mode="Ignore" class="hand-slot">
                            <ui:VisualElement picking-mode="Ignore" class="hand-icon" />
                        </ui:VisualElement>
                        <ui:Label text="Right" picking-mode="Ignore" class="mirror-btn__label" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Difficulty Selection -->
            <ui:VisualElement class="section-card">
                <ui:VisualElement class="section-header">
                    <ui:VisualElement class="section-header__icon" />
                    <ui:Label text="Difficulty" class="section-header__label" />
                </ui:VisualElement>
                <ui:VisualElement class="mirror-row">
                    <ui:VisualElement name="neuro-difficulty-easy" class="mirror-btn">
                        <ui:VisualElement picking-mode="Ignore" class="star-row">
                            <ui:VisualElement picking-mode="Ignore" class="star-icon">
                                <ui:VisualElement picking-mode="Ignore" class="star-fill-layer" />
                                <ui:VisualElement picking-mode="Ignore" class="star-outline-layer" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="star-icon star-icon--outline" />
                            <ui:VisualElement picking-mode="Ignore" class="star-icon star-icon--outline" />
                        </ui:VisualElement>
                        <ui:Label text="Easy" picking-mode="Ignore" class="mirror-btn__label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="neuro-difficulty-medium" class="mirror-btn">
                        <ui:VisualElement picking-mode="Ignore" class="star-row">
                            <ui:VisualElement picking-mode="Ignore" class="star-icon">
                                <ui:VisualElement picking-mode="Ignore" class="star-fill-layer" />
                                <ui:VisualElement picking-mode="Ignore" class="star-outline-layer" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="star-icon">
                                <ui:VisualElement picking-mode="Ignore" class="star-fill-layer" />
                                <ui:VisualElement picking-mode="Ignore" class="star-outline-layer" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="star-icon star-icon--outline" />
                        </ui:VisualElement>
                        <ui:Label text="Medium" picking-mode="Ignore" class="mirror-btn__label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="neuro-difficulty-hard" class="mirror-btn">
                        <ui:VisualElement picking-mode="Ignore" class="star-row">
                            <ui:VisualElement picking-mode="Ignore" class="star-icon">
                                <ui:VisualElement picking-mode="Ignore" class="star-fill-layer" />
                                <ui:VisualElement picking-mode="Ignore" class="star-outline-layer" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="star-icon">
                                <ui:VisualElement picking-mode="Ignore" class="star-fill-layer" />
                                <ui:VisualElement picking-mode="Ignore" class="star-outline-layer" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="star-icon">
                                <ui:VisualElement picking-mode="Ignore" class="star-fill-layer" />
                                <ui:VisualElement picking-mode="Ignore" class="star-outline-layer" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label text="Hard" picking-mode="Ignore" class="mirror-btn__label" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="neuro-hand-mode" class="section-card">
                <ui:VisualElement class="section-header">
                    <ui:VisualElement class="section-header__icon" />
                    <ui:Label text="Hand Mode" class="section-header__label" />
                    <ui:VisualElement class="section-header__spacer" />
                    <ui:VisualElement name="hand-mode-adv-btn" class="section-adv-btn">
                        <ui:Label text="Advanced" picking-mode="Ignore" class="advanced-toggle__label" />
                        <ui:VisualElement picking-mode="Ignore" class="toggle-track">
                            <ui:VisualElement picking-mode="Ignore" class="toggle-knob" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="hand-mode-options">
                    <ui:VisualElement name="option-normal" class="option-row">
                        <ui:VisualElement picking-mode="Ignore" class="radio-outer">
                            <ui:VisualElement picking-mode="Ignore" class="radio-inner" />
                        </ui:VisualElement>
                        <ui:VisualElement picking-mode="Ignore" class="option-text">
                            <ui:Label text="Left Hand Only" picking-mode="Ignore" class="option-text__label" />
                            <ui:Label text="Exercise using only the left hand" picking-mode="Ignore" class="option-text__desc" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="option-left-focused" class="option-row">
                        <ui:VisualElement picking-mode="Ignore" class="radio-outer">
                            <ui:VisualElement picking-mode="Ignore" class="radio-inner" />
                        </ui:VisualElement>
                        <ui:VisualElement picking-mode="Ignore" class="option-text">
                            <ui:Label text="Right Hand Only" picking-mode="Ignore" class="option-text__label" />
                            <ui:Label text="Exercise using only the right hand" picking-mode="Ignore" class="option-text__desc" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="option-right-focused" class="option-row">
                        <ui:VisualElement picking-mode="Ignore" class="radio-outer">
                            <ui:VisualElement picking-mode="Ignore" class="radio-inner" />
                        </ui:VisualElement>
                        <ui:VisualElement picking-mode="Ignore" class="option-text">
                            <ui:Label text="Both Hands Simultaneously" picking-mode="Ignore" class="option-text__label" />
                            <ui:Label text="Exercise using both hands together" picking-mode="Ignore" class="option-text__desc" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="hand-focus-slider" class="hfocus-slider section-hidden">
                    <ui:VisualElement class="hfocus-slider__labels">
                        <ui:Label text="Left" picking-mode="Ignore" class="hfocus-slider__end-label" />
                        <ui:Label text="Neutral" picking-mode="Ignore" class="hfocus-slider__end-label" />
                        <ui:Label text="Right" picking-mode="Ignore" class="hfocus-slider__end-label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="hfocus-track" class="hfocus-track">
                        <ui:VisualElement name="hfocus-knob" picking-mode="Ignore" class="hfocus-knob" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Height -->
            <ui:VisualElement name="neuro-height" class="section-card">
                <ui:VisualElement class="section-header">
                    <ui:VisualElement class="section-header__icon" />
                    <ui:Label text="Height" class="section-header__label" />
                </ui:VisualElement>
                <ui:Label text="Sets the height at which targets spawn during the session." class="section-description" />
                <ui:VisualElement name="option-eye-level" class="option-row">
                    <ui:VisualElement picking-mode="Ignore" class="radio-outer">
                        <ui:VisualElement picking-mode="Ignore" class="radio-inner" />
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="option-text">
                        <ui:Label text="Eye Level" picking-mode="Ignore" class="option-text__label" />
                        <ui:Label text="Targets arrive at chest and face height" picking-mode="Ignore" class="option-text__desc" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="option-height-high" class="option-row">
                    <ui:VisualElement picking-mode="Ignore" class="radio-outer">
                        <ui:VisualElement picking-mode="Ignore" class="radio-inner" />
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="option-text">
                        <ui:Label text="High" picking-mode="Ignore" class="option-text__label" />
                        <ui:Label text="Targets arrive at overhead and high-reach height" picking-mode="Ignore" class="option-text__desc" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="option-height-mixed" class="option-row">
                    <ui:VisualElement picking-mode="Ignore" class="radio-outer">
                        <ui:VisualElement picking-mode="Ignore" class="radio-inner" />
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="option-text">
                        <ui:Label text="Mixed" picking-mode="Ignore" class="option-text__label" />
                        <ui:Label text="A mix of eye level and high targets" picking-mode="Ignore" class="option-text__desc" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Target Bias -->
            <ui:VisualElement name="neuro-target-bias" class="section-card section-hidden">
                <ui:VisualElement class="section-header">
                    <ui:VisualElement class="section-header__icon" />
                    <ui:Label text="Target Bias" class="section-header__label" />
                </ui:VisualElement>
                <ui:Label text="Left–Right sets which hand targets favour. Up–Down sets punch height — eye level to overhead." class="bias-description" />
                <ui:VisualElement class="bias-wrapper">
                    <ui:Label text="Abduction" class="bias-axis-label" />
                    <ui:VisualElement class="bias-middle-row">
                        <ui:Label text="Left Hand" class="bias-axis-left" />
                        <ui:VisualElement name="bias-grid" class="bias-grid">
                            <!-- Minor lines (8×8) -->
                            <ui:VisualElement picking-mode="Ignore" style="top: 12.5%;" class="bias-grid__hline grid-minor" />
                            <ui:VisualElement picking-mode="Ignore" style="top: 37.5%;" class="bias-grid__hline grid-minor" />
                            <ui:VisualElement picking-mode="Ignore" style="top: 62.5%;" class="bias-grid__hline grid-minor" />
                            <ui:VisualElement picking-mode="Ignore" style="top: 87.5%;" class="bias-grid__hline grid-minor" />
                            <ui:VisualElement picking-mode="Ignore" style="left: 12.5%;" class="bias-grid__vline grid-minor" />
                            <ui:VisualElement picking-mode="Ignore" style="left: 37.5%;" class="bias-grid__vline grid-minor" />
                            <ui:VisualElement picking-mode="Ignore" style="left: 62.5%;" class="bias-grid__vline grid-minor" />
                            <ui:VisualElement picking-mode="Ignore" style="left: 87.5%;" class="bias-grid__vline grid-minor" />
                            <!-- Mid lines (4×4) -->
                            <ui:VisualElement picking-mode="Ignore" style="top: 25%;" class="bias-grid__hline grid-mid" />
                            <ui:VisualElement picking-mode="Ignore" style="top: 75%;" class="bias-grid__hline grid-mid" />
                            <ui:VisualElement picking-mode="Ignore" style="left: 25%;" class="bias-grid__vline grid-mid" />
                            <ui:VisualElement picking-mode="Ignore" style="left: 75%;" class="bias-grid__vline grid-mid" />
                            <!-- Major lines (2×2 centre) -->
                            <ui:VisualElement picking-mode="Ignore" class="bias-grid__hline" />
                            <ui:VisualElement picking-mode="Ignore" class="bias-grid__vline" />
                            <ui:VisualElement name="bias-dot-ghost" picking-mode="Ignore" class="bias-dot bias-dot--ghost" />
                            <ui:VisualElement name="bias-dot-active" picking-mode="Ignore" class="bias-dot bias-dot--active" />
                        </ui:VisualElement>
                        <ui:Label text="Right Hand" class="bias-axis-right" />
                    </ui:VisualElement>
                    <ui:Label text="Adduction" class="bias-axis-label" />
                </ui:VisualElement>
                <ui:VisualElement class="axis-slider">
                    <ui:VisualElement class="axis-slider__labels">
                        <ui:Label text="Left Hand" picking-mode="Ignore" class="axis-slider__label" />
                        <ui:Label text="Right Hand" picking-mode="Ignore" class="axis-slider__label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="bias-hslider" class="axis-slider__track">
                        <ui:VisualElement picking-mode="Ignore" style="left: 12.5%;" class="axis-slider__tick" />
                        <ui:VisualElement picking-mode="Ignore" style="left: 25%;" class="axis-slider__tick" />
                        <ui:VisualElement picking-mode="Ignore" style="left: 37.5%;" class="axis-slider__tick" />
                        <ui:VisualElement picking-mode="Ignore" style="left: 50%;" class="axis-slider__tick" />
                        <ui:VisualElement picking-mode="Ignore" style="left: 62.5%;" class="axis-slider__tick" />
                        <ui:VisualElement picking-mode="Ignore" style="left: 75%;" class="axis-slider__tick" />
                        <ui:VisualElement picking-mode="Ignore" style="left: 87.5%;" class="axis-slider__tick" />
                        <ui:VisualElement name="bias-hslider-knob" picking-mode="Ignore" class="axis-slider__knob" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="axis-slider">
                    <ui:VisualElement class="axis-slider__labels">
                        <ui:Label text="Adduction" picking-mode="Ignore" class="axis-slider__label" />
                        <ui:Label text="Abduction" picking-mode="Ignore" class="axis-slider__label" />
                    </ui:VisualElement>
                    <ui:VisualElement name="bias-vslider" class="axis-slider__track">
                        <ui:VisualElement picking-mode="Ignore" style="left: 12.5%;" class="axis-slider__tick" />
                        <ui:VisualElement picking-mode="Ignore" style="left: 25%;" class="axis-slider__tick" />
                        <ui:VisualElement picking-mode="Ignore" style="left: 37.5%;" class="axis-slider__tick" />
                        <ui:VisualElement picking-mode="Ignore" style="left: 50%;" class="axis-slider__tick" />
                        <ui:VisualElement picking-mode="Ignore" style="left: 62.5%;" class="axis-slider__tick" />
                        <ui:VisualElement picking-mode="Ignore" style="left: 75%;" class="axis-slider__tick" />
                        <ui:VisualElement picking-mode="Ignore" style="left: 87.5%;" class="axis-slider__tick" />
                        <ui:VisualElement name="bias-vslider-knob" picking-mode="Ignore" class="axis-slider__knob" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Start Button -->
        <ui:VisualElement name="start-btn" class="start-btn">
            <ui:Label text="Start VR Session" picking-mode="Ignore" class="start-btn__label" />
        </ui:VisualElement>

        <!-- Dropdown — last so it renders on top -->
        <ui:VisualElement name="game-dropdown" class="game-dropdown">
            <ui:VisualElement name="dropdown-airsac" class="dropdown-item">
                <ui:Label text="Air Sac Shapes" picking-mode="Ignore" class="dropdown-item__label" />
            </ui:VisualElement>
            <ui:VisualElement name="dropdown-neuromania" class="dropdown-item">
                <ui:Label text="NeuroMania" picking-mode="Ignore" class="dropdown-item__label" />
            </ui:VisualElement>
        </ui:VisualElement>


    </ui:VisualElement>
</ui:UXML>